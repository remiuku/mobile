# Optional publishable Spicy Lyrics client key (sl_pk_). Never use a secret sl_sk_ key.
SPICY_LYRICS_CLIENT_KEY=
# Optional Umami website id for anonymous usage stats (release builds only). Blank sends nothing.
UMAMI_WEBSITE_ID=
# Optional Spotify Canvas Worker (server/canvas), e.g. https://canvas.tx24.dev/api/canvas.
# Blank asks spotify-canva.vercel.app directly.
SPOTIFY_CANVAS_URL=
